{
  "compilerOptions": {
    "lib": ["es2023"],
    "target": "es2023",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "types": ["node", "mocha"],
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": false,
    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}
